# --- GT backend ---
GT_PORT=4010
GT_BASE_PATH=/api
GT_DB_SCHEMA=tarifas
GT_REQUIRED_ROLE=gt-user
GT_CORS_ORIGINS=http://localhost:5173

# Directorio del build del frontend. Si se define, el backend sirve la app y la
# API en el MISMO puerto (sin CORS): es lo que hace viable exponerlo por tunel.
GT_FRONTEND_DIST=../frontend/dist

# 'keycloak' (por defecto) | 'off'. 'off' desactiva token y rol: SOLO para
# pruebas en tunel / Render, donde no hay un Keycloak alcanzable.
# GT_AUTH=off

# PostgreSQL (compartido con el monolito).
# DATABASE_URL gana sobre las PG* cuando existe: es lo unico que da Render.
# DATABASE_URL=postgres://usuario:clave@host:5432/base
# PGSSLMODE=require
PGHOST=postgres
PGPORT=5432
PGUSER=doxia
PGPASSWORD=doxia
PGDATABASE=doxia

# Keycloak (Auth compartido)
KEYCLOAK_ISSUER=http://keycloak:8080/realms/doxia
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/doxia/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=gt-backend
