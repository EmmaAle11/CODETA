# --- GT · Gestor de Tarifas · frontend ---
GT_PUBLIC_BASE=/
GT_API_TARGET=http://localhost:4010

# Variables expuestas al cliente (deben iniciar con VITE_)
VITE_API_BASE=/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=doxia
VITE_KEYCLOAK_CLIENT_ID=gt-frontend

# 'off' apaga el login SOLO para pruebas con `npm run dev`. En producción el
# backend inyecta este valor en runtime (GT_AUTH); no hace falta hornearlo.
# VITE_AUTH=off
